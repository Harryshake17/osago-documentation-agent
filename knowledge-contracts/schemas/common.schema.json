{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osago:kb:1.0",
  "$defs": {
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "score",
        "rationale"
      ]
    },
    "package_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "revisions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "time_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unresolved_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "repositories",
        "revisions",
        "components",
        "scenarios",
        "environments",
        "time_range",
        "exclusions",
        "unresolved_constraints"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "enum": [
            "repository",
            "git_history",
            "tests",
            "confluence",
            "jira",
            "opensearch"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hash_scope": {
          "enum": [
            "full_content",
            "excerpt"
          ]
        },
        "working_tree_state": {
          "enum": [
            "clean",
            "dirty",
            "not_applicable",
            "unknown"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "adapter",
        "locator",
        "repository",
        "revision",
        "commit",
        "retrieved_at",
        "content_hash",
        "hash_scope",
        "working_tree_state",
        "availability",
        "excerpt"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "Domain",
            "Scenario",
            "Capability",
            "Actor",
            "UserAction",
            "BusinessRule",
            "Decision",
            "State",
            "Integration",
            "ApiOperation",
            "CodeComponent",
            "ConfigRule",
            "Error",
            "ScenarioStep",
            "SystemBehaviour",
            "StateChange",
            "UserResult"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "preferred_name": {
          "$ref": "urn:osago:kb:1.0#/$defs/preferred_name"
        },
        "technical_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "search_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "terminology_candidates": {
          "type": "array",
          "items": {
            "$ref": "urn:osago:kb:1.0#/$defs/terminology_candidate"
          },
          "uniqueItems": true
        },
        "identity_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "CODE",
            "CONFIG",
            "TEST",
            "CONFLUENCE",
            "JIRA",
            "INFERENCE",
            "GIT",
            "OPENSEARCH"
          ]
        },
        "source_location": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "score",
            "rationale"
          ]
        },
        "inference": {
          "type": "boolean"
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": [
                "string",
                "null"
              ]
            },
            "file": {
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "page": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "repository",
            "file",
            "symbol",
            "revision",
            "page"
          ]
        },
        "runtime": {
          "$ref": "urn:osago:kb:1.0#/$defs/runtime_context"
        }
      },
      "required": [
        "id",
        "source_type",
        "source_location",
        "repository",
        "file",
        "class",
        "method",
        "page",
        "section",
        "version",
        "commit",
        "snapshot_id",
        "confidence",
        "inference",
        "excerpt",
        "basis_claim_ids",
        "rationale"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "OPENSEARCH"
              }
            }
          },
          "then": {
            "required": [
              "runtime"
            ],
            "properties": {
              "inference": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "text": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "enum": [
            "implemented",
            "configured",
            "test_expectation",
            "documented_requirement",
            "source_statement",
            "runtime_observation",
            "inferred",
            "discovery"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "environment": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "repository",
            "revision",
            "environment"
          ]
        },
        "support": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "supports",
                  "contradicts",
                  "context"
                ]
              }
            },
            "required": [
              "evidence_id",
              "role"
            ]
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "score",
            "rationale"
          ]
        },
        "inference": {
          "type": "boolean"
        },
        "validation_status": {
          "enum": [
            "proposed",
            "supported",
            "needs_review",
            "rejected"
          ]
        },
        "lifecycle_status": {
          "enum": [
            "current",
            "stale",
            "superseded"
          ]
        },
        "knowledge_status": {
          "$ref": "urn:osago:kb:1.0#/$defs/knowledge_status"
        },
        "basis_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "inference_rationale": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "value",
        "text",
        "modality",
        "context",
        "support",
        "confidence",
        "inference",
        "validation_status",
        "lifecycle_status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "modality": {
                "const": "runtime_observation"
              },
              "value": {
                "type": "object",
                "required": [
                  "confirmation_ref"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "urn:osago:kb:1.0#/$defs/runtime_observation_value"
              },
              "inference": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "missing_source",
            "missing_link",
            "unknown_scope",
            "unknown_version",
            "unknown_reason",
            "unverified",
            "unknown_field",
            "RUNTIME_UNVERIFIED",
            "STATIC_RUNTIME_CONFLICT",
            "RUNTIME_VARIABILITY",
            "INSUFFICIENT_RUNTIME_SAMPLE"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "publication_relevance": {
          "$ref": "urn:osago:kb:1.0#/$defs/publication_relevance"
        }
      },
      "required": [
        "id",
        "reason",
        "question",
        "affected_ids",
        "next_action",
        "status"
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
