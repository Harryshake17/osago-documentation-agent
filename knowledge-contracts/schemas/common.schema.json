        "source_type",
        "artifact_kind",
        "category",
        "repository",
        "path",
        "symbol",
        "page_id",
        "section",
        "source_location",
        "version",
        "commit",
        "snapshot_ref",
        "relevance",
        "relevance_claim_ids",
