        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 2
        },
        "disagreement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "unresolved",
            "resolved"
          ]
        },
        "resolution_claim_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "claim_ids",
        "disagreement",
        "status",
        "resolution_claim_id"
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string",
          "minLength": 1
