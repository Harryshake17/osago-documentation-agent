{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osago:documentation-run:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "IN_PROGRESS",
        "WAITING_FOR_USER",
        "FAILED",
        "COMPLETED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "content_hash",
        "schema"
      ]
    },
    "glossary_baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "content_hash",
        "schema"
      ]
    },
    "pipeline": {
      "$ref": "urn:osago:documentation-pipeline:1.0"
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "domain_id": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "schema": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "path",
                "content_hash",
                "schema"
              ]
            }
          }
        },
        "required": [
          "id",
          "scenario_id",
          "domain_id",
          "artifacts"
        ]
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "spec_id": {
            "type": "string",
            "minLength": 1
          },
          "item_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "PENDING",
              "RUNNING",
              "COMPLETED",
              "WAITING_FOR_REVIEW",
              "STALE",
              "FAILED",
              "SKIPPED"
            ]
          },
          "input_fingerprints": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "bundle": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "schema": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "path",
                "content_hash",
                "schema"
              ]
            }
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "directory": {
                  "type": "string",
                  "minLength": 1
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "finished_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "RUNNING",
                    "COMPLETED",
                    "FAILED"
                  ]
                },
                "error": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "type": "string",
                          "minLength": 1
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1
                        },
                        "timestamp": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "type",
                        "message",
                        "timestamp"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "artifacts": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "content_hash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "schema": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "content_hash",
                      "schema"
                    ]
                  }
                }
              },
              "required": [
                "number",
                "directory",
                "started_at",
                "finished_at",
                "status",
                "error",
                "artifacts"
              ]
            }
          },
          "correction_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "spec_id",
          "item_id",
          "active",
          "dependencies",
          "status",
          "input_fingerprints",
          "bundle",
          "attempts",
          "correction_ids",
          "approval_id"
        ]
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "APPROVE",
              "CORRECT"
            ]
          },
          "response": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "input_fingerprints": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "target_node": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "ACCEPTED",
              "PENDING",
              "APPLIED",
              "STALE"
            ]
          },
          "applied_artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "schema": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "path",
                "content_hash",
                "schema"
              ]
            }
          }
        },
        "required": [
          "id",
          "node_id",
          "decision",
          "response",
          "timestamp",
          "input_fingerprints",
          "target_node",
          "status",
          "applied_artifacts"
        ]
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "content_hash",
            "schema"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "created_at",
    "updated_at",
    "request",
    "glossary_baseline",
    "pipeline",
    "work_items",
    "nodes",
    "reviews",
    "results"
  ]
}
