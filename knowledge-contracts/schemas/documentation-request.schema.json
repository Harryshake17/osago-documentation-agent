{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osago:documentation-request:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "scope_hints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "existing_document": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "domain"
  ]
}
