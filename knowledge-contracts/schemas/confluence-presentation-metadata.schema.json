{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osago:confluence-presentation-metadata:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_hashes"
  ],
  "properties": {
    "inline_identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "asset_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diagrams": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file",
          "caption"
        ],
        "properties": {
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "rendered_file": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
