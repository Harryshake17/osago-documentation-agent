{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osago:glossary-selection:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_ref": {
            "$ref": "urn:osago:kb:1.0#/$defs/entity/properties/id"
          },
          "type": {
            "$ref": "urn:osago:glossary-term:1.0#/properties/type"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "entity_ref",
          "type",
          "reason"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "selections"
  ]
}
